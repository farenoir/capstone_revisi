# ==============================================================================
# SISTEM INFORMASI PENCATATAN BARANG MASUK DAN KELUAR ATK
# File Contoh Konfigurasi Lingkungan (.env.example)
#
# PANDUAN PENGGUNA:
# Salin file ini menjadi .env di dalam direktori server/ dan isi variabel berikut
# sesuai konfigurasi database MySQL yang Anda sediakan di sistem Anda.
# JANGAN cantumkan kredensial rahasia ke repositori git atau commit.
# ==============================================================================

# Pengaturan Server
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Konfigurasi Database MySQL (Disediakan oleh Pengguna)
# Format URL Koneksi Prisma:
# mysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
# Contoh bila tidak ada password: mysql://root:@localhost:3306/sistem_atk
# Isi DATABASE_URL di bawah ini dengan kredensial database Anda:
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME"

# Variabel Tambahan (Opsional jika ingin mengatur per komponen)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=sistem_atk

# Keamanan & JWT
# Ganti JWT_SECRET dengan string acak rahasia yang aman
JWT_SECRET=
JWT_EXPIRES_IN=8h
LOG_LEVEL=info
