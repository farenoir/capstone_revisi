# ==============================================================================
# SISTEM INFORMASI PENCATATAN BARANG MASUK DAN KELUAR ATK - SERVER CONFIG
# ==============================================================================

NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Konfigurasi Database MySQL (Disediakan oleh Pengguna)
# Format URL Koneksi Prisma:
# mysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
# Contoh: mysql://root:@localhost:3306/sistem_atk
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/sistem_atk"

# JWT Secret untuk sesi autentikasi (Gunakan string acak rahasia)
JWT_SECRET=super_secret_jwt_key_sistem_atk_2026
JWT_EXPIRES_IN=8h
LOG_LEVEL=info
